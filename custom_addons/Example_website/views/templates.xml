<odoo>
    <data>
        <template id="Example_website_template" name="Home Page">
            <t t-call="web.layout">
<!--                <t t-set="no_header" t-value="true"/>-->
<!--                <t t-set="no_footer" t-value="true"/>-->
                <!--<div id="wrap" class="container">-->
                    <head>
                      <meta charset="UTF-8"/>
                      <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                      <title>Inicio · Bootstrap con encabezado y pie</title>
                      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
                      <style>
                        /* Pequeño ajuste para que el footer siempre quede abajo en páginas con poco contenido */
                        body {
                          min-height: 100vh;
                          display: flex;
                          flex-direction: column;
                        }
                        main {
                          flex: 1 0 auto; /* empuja el footer hacia abajo */
                        }
                        /* Opcional: separación suave en el main */
                        .feature-icon {
                          font-size: 3rem;
                          color: #0d6efd;
                        }
                      </style>
                    </head>
                    <body>

                      <!-- ==================== ENCABEZADO (navbar) ==================== -->
                      <header>
                        <nav class="navbar navbar-expand-lg bg-primary navbar-dark">
                          <div class="container">
                            <!-- Logo / nombre del sitio -->
                            <a class="navbar-brand" href="#">
                              <i class="bi bi-bootstrap-fill me-2"></i>MiPágina
                            </a>

                            <!-- Botón hamburguesa para móvil -->
                            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarPrincipal"
                                    aria-controls="navbarPrincipal" aria-expanded="false" aria-label="Alternar navegación">
                              <span class="navbar-toggler-icon"></span>
                            </button>

                            <!-- Menú de navegación -->
                            <div class="collapse navbar-collapse" id="navbarPrincipal">
                              <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                                <li class="nav-item">
                                  <a class="nav-link active" aria-current="page" href="#">Inicio</a>
                                </li>
                                <li class="nav-item">
                                  <a class="nav-link" href="#">Características</a>
                                </li>
                                <li class="nav-item">
                                  <a class="nav-link" href="#">Precios</a>
                                </li>
                                <li class="nav-item dropdown">
                                  <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Más
                                  </a>
                                  <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#">Acción</a></li>
                                    <li><a class="dropdown-item" href="#">Otra acción</a></li>
                                      <li><hr class="dropdown-divider"/></li>
                                    <li><a class="dropdown-item" href="#">Algo más aquí</a></li>
                                  </ul>
                                </li>
                              </ul>
                              <!-- Buscador sencillo (opcional) -->
                              <form class="d-flex ms-lg-3" role="search">
                                <input class="form-control me-2" type="search" placeholder="Buscar..." aria-label="Buscar"/>
                                <button class="btn btn-outline-light me-2" type="submit"><i class="bi bi-search"></i></button>
                              </form>
                              <button class="btn btn-outline-light" type="object" string="" name=""><i class="bi bi-cart4"></i></button>
                            </div>
                          </div>
                        </nav>
                      </header>

                      <!-- ==================== CONTENIDO PRINCIPAL (main) ==================== -->
                      <main class="container my-5">
                        <!-- Título de bienvenida -->
                        <div class="row mb-4">
                          <div class="col-12 text-center">
                            <h1 class="display-4 fw-normal">Bienvenido a tu <span class="text-primary">nueva página en Odoo</span></h1>
                            <p class="lead text-secondary">Un esqueleto completo usando Bootstrap 5.</p>
                            <hr class="w-50 mx-auto"/>
                          </div>
                        </div>

                        <!-- Sección de tarjetas (relleno visual) -->
                        <div class="row g-4">
                          <div class="col-md-4">
                            <div class="card" style="width: 18 rem;">
                              <img srtc="...." class="card-img-top" alt="Imagen producto"/>
                              <div class="card-body text-center">
                                 <i class="bi bi-laptop feature-icon"></i>
                                <h3 class="card-title h5 mt-3">Artículo #1</h3>
                                <p class="card-text">Descripcion del artículo No. 1 a la venta en la pagina web.</p>
                                <a href="#" class="btn btn-primary"><span class="bi bi-cart-plus"></span> Añadir al carrito</a>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="card h-100 shadow-sm">
                              <img srtc="...." class="card-img-top" alt="Imagen producto"/>
                              <div class="card-body text-center">
                                <i class="bi bi-palette feature-icon"></i>
                                <h3 class="card-title h5 mt-3">Articulo #2</h3>
                                <p class="card-text">Descripción del artículo No. 2 a la venta en pagina web</p>
                                <a href="#" class="btn btn-primary"><span class="bi bi-cart-plus"></span> Añadir al carrito</a>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="card h-100 shadow-sm">
                              <img srtc="...." class="card-img-top" alt="Imagen producto"/>
                              <div class="card-body text-center">
                                <i class="bi bi-file-code feature-icon"></i>
                                <h3 class="card-title h5 mt-3">Artículo No. 3</h3>
                                <p class="card-text">Descripcion del artículo No.3 a la venta en pagina eb.</p>
                                <a href="#" class="btn btn-primary"><span class="bi bi-cart-plus"></span> Añadir al carrito</a>
                              </div>
                            </div>
                          </div>
                        </div>

                        <hr class="border-primary border-2 opacity-75"/>

                        <!-- Sección de tarjetas (relleno visual) -->
                        <div class="row g-4">
                          <div class="col-md-4">
                            <div class="card" style="width: 18 rem;">
                              <img srtc="...." class="card-img-top" alt="Imagen producto"/>
                              <div class="card-body text-center">
                                 <i class="bi bi-laptop feature-icon"></i>
                                <h3 class="card-title h5 mt-3">Artículo #4</h3>
                                <p class="card-text">Descripcion del artículo No. 4 a la venta en la pagina web.</p>
                                <a href="#" class="btn btn-primary"><span class="bi bi-cart-plus"></span> Añadir al carrito</a>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="card h-100 shadow-sm">
                              <img srtc="...." class="card-img-top" alt="Imagen producto"/>
                              <div class="card-body text-center">
                                <i class="bi bi-palette feature-icon"></i>
                                <h3 class="card-title h5 mt-3">Artículo #5</h3>
                                <p class="card-text">Descripción del artículo No. 5 a la venta en pagina web</p>
                                <a href="#" class="btn btn-primary"><span class="bi bi-cart-plus"></span> Añadir al carrito</a>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="card h-100 shadow-sm">
                              <img srtc="...." class="card-img-top" alt="Imagen producto"/>
                              <div class="card-body text-center">
                                <i class="bi bi-file-code feature-icon"></i>
                                <h3 class="card-title h5 mt-3">Artículo No. 6</h3>
                                <p class="card-text">Descripcion del artículo No.6 a la venta en pagina eb.</p>
                                <a href="#" class="btn btn-primary"><span class="bi bi-cart-plus"></span> Añadir al carrito</a>
                              </div>
                            </div>
                          </div>
                        </div>
                        <!-- Segunda fila: contenido adicional de ejemplo -->
                        <div class="row mt-5 align-items-center">
                          <div class="col-md-6">
                            <h2>¿Por qué usar Bootstrap?</h2>
                            <p class="text-muted">Acelera el desarrollo con componentes listos y un sistema de rejilla potente. Este ejemplo incluye navbar, dropdown, cards, íconos y un footer con columnas.</p>
                            <!--<button class="btn btn-primary" name="open_modal_button" string="Saber más" type="object"><i class="bi bi-arrow-right"></i></button>-->
                            <owl-component name="Example_website.active_modal"/>
                          </div>
                          <div class="col-md-6 mt-4 mt-md-0 text-center">
                            <!-- Ilustración simple con un icono grande -->
                            <i class="bi bi-bootstrap" style="font-size: 10rem; color: #6f42c1;"></i>
                          </div>
                        </div>
                      </main>

                      <!-- ==================== PIE DE PÁGINA (footer) ==================== -->
                      <footer class="bg-dark text-white pt-5 pb-4 mt-5">
                        <div class="container">
                          <div class="row gy-4">
                            <!-- Columna 1: información breve -->
                            <div class="col-lg-4 col-md-6">
                              <h5 class="text-uppercase fw-bold"><i class="bi bi-bootstrap-fill me-2"></i>MiPágina</h5>
                              <p>Un ejemplo simple de página de inicio con encabezado y pie usando Bootstrap 5. Ideal para comenzar cualquier proyecto.</p>
                            </div>
                            <!-- Columna 2: enlaces rápidos -->
                            <div class="col-lg-2 col-md-6">
                              <h5 class="fw-bold">Enlaces</h5>
                              <ul class="list-unstyled">
                                <li><a href="#" class="text-white-50 text-decoration-none">Inicio</a></li>
                                <li><a href="#" class="text-white-50 text-decoration-none">Características</a></li>
                                <li><a href="#" class="text-white-50 text-decoration-none">Precios</a></li>
                                <li><a href="#" class="text-white-50 text-decoration-none">FAQ</a></li>
                              </ul>
                            </div>
                            <!-- Columna 3: recursos -->
                            <div class="col-lg-3 col-md-6">
                              <h5 class="fw-bold">Recursos</h5>
                              <ul class="list-unstyled">
                                <li><a href="#" class="text-white-50 text-decoration-none">Documentación Bootstrap</a></li>
                                <li><a href="#" class="text-white-50 text-decoration-none">Ejemplos</a></li>
                                <li><a href="#" class="text-white-50 text-decoration-none">Iconos</a></li>
                                <li><a href="#" class="text-white-50 text-decoration-none">Soporte</a></li>
                              </ul>
                            </div>
                            <!-- Columna 4: contacto y redes -->
                            <div class="col-lg-3 col-md-6">
                              <h5 class="fw-bold">Contacto</h5>
                              <p><i class="bi bi-envelope-fill me-2"></i>info@mipagina.ejemplo</p>
                              <p><i class="bi bi-telephone-fill me-2"></i>+34 123 456 789</p>
                              <div class="mt-3">
                                <a href="#" class="text-white-50 me-3"><i class="bi bi-twitter fs-5"></i></a>
                                <a href="#" class="text-white-50 me-3"><i class="bi bi-facebook fs-5"></i></a>
                                <a href="#" class="text-white-50 me-3"><i class="bi bi-instagram fs-5"></i></a>
                                <a href="#" class="text-white-50"><i class="bi bi-github fs-5"></i></a>
                              </div>
                            </div>
                          </div>
                          <!-- Línea inferior con copyright -->
                          <div class="row mt-4">
                            <div class="col-12 text-center pt-3 border-top border-secondary">
                              <p class="mb-0 text-white-50">© 2026 MiPágina · Todos los derechos reservados</p>
                            </div>
                          </div>
                        </div>
                      </footer>

                      <!-- Bootstrap JS (Popper incluido) para componentes interactivos (navbar toggler, dropdowns) -->
                      <!--<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>-->
                    </body>
                    <!--ventana modal-->
                    <div class="myModal modal fade" id="myModal" tabindex="-1">
                      <div class="modal-dialog">
                        <div class="modal-content">
                          <div class="modal-header">
                            <h5 class="modal-title">Modal Title</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body">Modal Content</div>
                        </div>
                      </div>
                    </div>
                <!--</div>-->
            </t>
        </template>
    </data>
</odoo>